generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  name      String
  email     String   @unique
  image     String?
  createdAt DateTime @default(now())
  
  // New Fields for WhatsApp-like features
  pinnedChatIds String[] @default([]) 
  mutedChatIds  String[] @default([])

  sentMessages     Message[] @relation("Sender")
  receivedMessages Message[] @relation("Receiver")

  initiatedCalls CallLog[] @relation("InitiatedCalls")
  receivedCalls  CallLog[] @relation("ReceivedCalls")
}

model Message {
  id         String   @id @default(uuid())
  content    String
  type       String
  
  senderId   String
  receiverId String

  deletedByIds String[] @default([])
  
  sender     User     @relation("Sender", fields: [senderId], references: [clerkId])
  receiver   User     @relation("Receiver", fields: [receiverId], references: [clerkId])
  
  createdAt  DateTime @default(now())
}

model CallLog {
  id        String   @id @default(uuid())
  initiatorId String
  receiverId String? // Nullable for group calls
  type      String   // "AUDIO" | "VIDEO" | "GROUP"
  status    String   // "MISSED" | "COMPLETED"
  startedAt DateTime @default(now())
  endedAt   DateTime?

  initiator User @relation("InitiatedCalls", fields: [initiatorId], references: [clerkId])
  receiver  User? @relation("ReceivedCalls", fields: [receiverId], references: [clerkId])

  @@index([initiatorId])
  @@index([receiverId])
}